# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Backend bundler config
/backend/.bundle

# Backend env files
/backend/.env*

# Backend logs and temp files
/backend/log/*
/backend/tmp/*
!/backend/log/.keep
!/backend/tmp/.keep

# Backend pid files
/backend/tmp/pids/*
!/backend/tmp/pids/
!/backend/tmp/pids/.keep

# Backend storage
/backend/storage/*
!/backend/storage/.keep
/backend/tmp/storage/*
!/backend/tmp/storage/
!/backend/tmp/storage/.keep

# Backend credentials keys
/backend/config/*.key

# Frontend dependencies and build output
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/.vite/

# Frontend logs
/frontend/logs/
/frontend/*.log
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*
/frontend/lerna-debug.log*

# Frontend local env files
/frontend/*.local

# Frontend editor files
/frontend/.vscode/*
!/frontend/.vscode/extensions.json
/frontend/.DS_Store
/frontend/*.suo
/frontend/*.ntvs*
/frontend/*.njsproj
/frontend/*.sln
/frontend/*.sw?

# IDE files
.idea/
